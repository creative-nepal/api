NODE_ENV=development
PORT=3333
# fatal|error|warn|info|debug|trace|silent. Defaults to debug in development,
# info in production, silent under Jest — set explicitly to override.
LOG_LEVEL=

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/creative_nepal
# TLS to the database. Defaults to required in production, off elsewhere; set
# explicitly for a local server with no certificate.
DATABASE_SSL=false
# Bound per instance so several instances cannot exhaust the provider's cap.
DATABASE_POOL_SIZE=10

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3333

# Comma-separated list of origins allowed to call the API with credentials
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email (password reset, OTP verification) via Resend: https://resend.com/api-keys
RESEND_API_KEY=
# Must be a verified sender/domain in Resend; defaults to the Resend sandbox address
EMAIL_FROM=Creative Nepal <onboarding@resend.dev>

# Used by `bun run db:seed:admin` to create/promote an admin user
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin

# Tenant page that accepts a staff invitation. Must be https in production.
INVITATION_ACCEPT_URL=http://localhost:3000/accept-invitation

# --- CMS ---------------------------------------------------------------------
# Shared with creative-nepal-web and creative-nepal-admin. Lets an admin preview unpublished pages;
# leave empty to disable draft preview entirely. Generate with: openssl rand -base64 24
CONTENT_PREVIEW_SECRET=
# Pinged after every CMS write so the public site drops its cached pages. Without
# it, published changes appear only when the 5-minute cache window lapses.
WEB_REVALIDATE_URL=http://localhost:3000/api/content/revalidate
WEB_REVALIDATE_SECRET=

# --- Template / whitelabel ---------------------------------------------------
# Which sectors this deployment mounts. Comma-separated subset of
# mart,medical,restaurant,services. Blank = all. An unknown key fails the boot rather
# than silently mounting everything. Gates modules, routes and seeds — not the
# access-control vocabulary, which always compiles in every sector.
SECTORS_ENABLED=
# Whitelabel name used in transactional email and by the CMS/plan seeds. The
# name the frontends render comes from the API i18n catalogue (ui.brand.*).
BRAND_NAME=Creative Nepal
BRAND_SUPPORT_EMAIL=

# Used by `bun run db:seed:demo` to create one demo business per enabled sector
SEED_DEMO_EMAIL=demo@example.com
SEED_DEMO_PASSWORD=

# --- Object storage (RustFS, S3-compatible) ----------------------------------
# Local stack: docker compose up -d rustfs
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=creative-nepal
# Required in production; without them uploads are refused rather than silently lost
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
